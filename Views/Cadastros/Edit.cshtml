@model CosturaProducao.ViewModels.CadastroInputVm

@{
    ViewData["Title"] = "Editar cadastro";

    var isService = Model.Tipo == "servicos";
    var isPiece = Model.Tipo == "pecas";
}

<section class="dashboard" data-testid="registration-edit-page">

    <div class="page-heading">
        <div>
            <p class="eyebrow">
                EDITAR REGISTRO · @Model.Tipo.ToUpperInvariant()
            </p>

            <h1>Editar</h1>
        </div>

        <a href="/Cadastros?tipo=@Model.Tipo"
           data-testid="registration-cancel-link">
            Voltar
        </a>
    </div>


    <form asp-controller="Cadastros"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="registration-form"
          data-testid="registration-edit-form">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Tipo" />


        <!-- ERROS -->

        <div asp-validation-summary="ModelOnly"
             class="form-error"
             data-testid="registration-form-error">
        </div>


        <!-- NOME -->

        <label asp-for="Nome">
            Nome

            <input asp-for="Nome"
                   autocomplete="off"
                   data-testid="registration-name-input" />
        </label>

        <span asp-validation-for="Nome"
              class="form-error">
        </span>


        <!-- ================================================= -->
        <!-- PEÇA -->
        <!-- ================================================= -->
        @if (isPiece)
        {
            <!-- CÓDIGO -->

            <label asp-for="Codigo">
                Código

                <input asp-for="Codigo"
                       data-testid="piece-code-input" />
            </label>

            <span asp-validation-for="Codigo"
                  class="form-error">
            </span>


            <!-- ============================================= -->
            <!-- CORES E TAMANHOS -->
            <!-- ============================================= -->

            <div class="variants-section">

                <h3>Cores e tamanhos</h3>

                <p>
                    Cadastre as combinações de cor e tamanho
                    disponíveis para esta peça.
                </p>


                <div id="variants-container">

                    @for (int i = 0; i < Model.Variants.Count; i++)
                    {
                        <div class="variant-row">

                            <input type="hidden"
                                   asp-for="Variants[i].Id" />


                            <div class="variant-field">

                                <label>
                                    Cor
                                </label>

                                <input asp-for="Variants[i].Cor"
                                       placeholder="Ex.: Azul"
                                       class="form-control" />

                            </div>


                            <div class="variant-field">

                                <label>
                                    Tamanho
                                </label>

                                <input asp-for="Variants[i].Tamanho"
                                       placeholder="Ex.: M"
                                       class="form-control" />

                            </div>


                            <button type="button"
                                    class="btn btn-danger btn-sm"
                                    onclick="removerVariante(this)">
                                Remover
                            </button>

                        </div>
                    }

                </div>


                <!-- ADICIONAR -->

                <button type="button"
                        class="btn btn-secondary btn-sm"
                        onclick="adicionarVariante()">

                    + Adicionar cor/tamanho

                </button>

            </div>


            <!-- ============================================= -->
            <!-- GABARITO -->
            <!-- ============================================= -->
            @if (!string.IsNullOrWhiteSpace(Model.GabaritoAtual))
            {
                <div class="current-template">

                    <p>
                        Gabarito atual:
                    </p>

                    <img src="@Model.GabaritoAtual"
                         alt="Gabarito atual"
                         style="max-width:300px; max-height:300px;" />

                </div>
            }


            <label asp-for="Gabarito">

                Alterar imagem do gabarito

                <input asp-for="Gabarito"
                       type="file"
                       accept="image/png,image/jpeg,image/webp"
                       data-testid="piece-template-input" />

            </label>

            <small>
                Deixe vazio para manter o gabarito atual.
            </small>
        }


        <!-- ================================================= -->
        <!-- COSTUREIRA / CLIENTE -->
        <!-- ================================================= -->
        @if (!isService && !isPiece)
        {
            <label asp-for="Telefone">

                Telefone

                <input asp-for="Telefone"
                       data-testid="registration-phone-input" />

            </label>


            <label asp-for="Endereco">

                Endereço

                <input asp-for="Endereco"
                       data-testid="registration-address-input" />

            </label>
        }


        <!-- ================================================= -->
        <!-- SERVIÇO -->
        <!-- ================================================= -->
        @if (isService)
        {
            <label asp-for="ValorPorPeca">

                Valor por peça

                <input asp-for="ValorPorPeca"
                       type="number"
                       min="0"
                       step="0.01"
                       data-testid="service-price-input" />

            </label>

            <span asp-validation-for="ValorPorPeca"
                  class="form-error">
            </span>
        }


        <!-- ================================================= -->
        <!-- DESCRIÇÃO -->
        <!-- ================================================= -->
        @if (isPiece || isService)
        {
            <label asp-for="Descricao">

                Descrição

                <textarea asp-for="Descricao"
                          rows="4"
                          data-testid="registration-description-input"></textarea>

            </label>
        }


        <!-- ================================================= -->
        <!-- OBSERVAÇÕES -->
        <!-- ================================================= -->
        @if (!isService && !isPiece)
        {
            <label asp-for="Observacoes">

                Observações

                <textarea asp-for="Observacoes"
                          rows="4"
                          data-testid="registration-notes-input"></textarea>

            </label>
        }


        <!-- ================================================= -->
        <!-- BOTÕES -->
        <!-- ================================================= -->

        <div class="form-actions">

            <a href="/Cadastros?tipo=@Model.Tipo"
               class="btn btn-secondary">

                Cancelar

            </a>


            <button class="btn btn-primary"
                    type="submit"
                    data-testid="registration-save-button">

                Salvar alterações

            </button>

        </div>

    </form>

</section>


<!-- ========================================================= -->
<!-- JAVASCRIPT DAS VARIANTES -->
<!-- ========================================================= -->
@if (isPiece)
{
    <script>

        let variantIndex =
            @Model.Variants.Count;


        function adicionarVariante()
        {
            const container =
                document.getElementById("variants-container");


            const row =
                document.createElement("div");

            row.className =
                "variant-row";


            row.innerHTML = `

                <div class="variant-field">

                    <label>
                        Cor
                    </label>

                    <input
                        name="Variants[${variantIndex}].Cor"
                        class="form-control"
                        placeholder="Ex.: Azul" />

                </div>


                <div class="variant-field">

                    <label>
                        Tamanho
                    </label>

                    <input
                        name="Variants[${variantIndex}].Tamanho"
                        class="form-control"
                        placeholder="Ex.: M" />

                </div>


                <button
                    type="button"
                    class="btn btn-danger btn-sm"
                    onclick="removerVariante(this)">

                    Remover

                </button>

            `;


            container.appendChild(row);

            variantIndex++;
        }


        function removerVariante(button)
        {
            const row =
                button.closest(".variant-row");


            if (row)
            {
                row.remove();
            }
        }

    </script>
}