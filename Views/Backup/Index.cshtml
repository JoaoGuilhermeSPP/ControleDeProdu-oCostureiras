@{
    ViewData["Title"] = "Backup";
}

<div class="container py-4">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <div class="d-flex align-items-center mb-3">

                        <div>
                            <h2 class="mb-1">
                                Backup do sistema
                            </h2>

                            <p class="text-muted mb-0">
                                Faça uma cópia completa dos dados do
                                CosturaProducao.
                            </p>
                        </div>

                    </div>

                    <hr />

                    <div class="alert alert-info">

                        <strong>Como funciona?</strong>

                        <p class="mb-0 mt-2">
                            O sistema irá gerar uma cópia completa do
                            banco de dados, compactá-la em um arquivo
                            <strong>.rar</strong> e iniciar o download.
                        </p>

                    </div>

                    @if (TempData["BackupErro"] != null)
                    {
                        <div class="alert alert-danger">
                            <strong>Erro:</strong>
                            @TempData["BackupErro"]
                        </div>
                    }

                    <form asp-controller="Backup"
                          asp-action="Criar"
                          method="post"
                          id="formBackup">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                id="btnBackup"
                                class="btn btn-primary btn-lg w-100">

                            <span id="textoBackup">
                                Fazer Backup
                            </span>

                        </button>

                    </form>

                    <div class="mt-3 text-muted small">

                        <strong>Importante:</strong>

                        <ul class="mb-0 mt-2">

                            <li>
                                Guarde o arquivo em um local seguro.
                            </li>

                            <li>
                                Recomendamos usar um pendrive,
                                HD externo ou armazenamento em nuvem.
                            </li>

                            <li>
                                O arquivo contém os dados completos
                                do sistema.
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <script>

        const formBackup =
            document.getElementById("formBackup");

        const btnBackup =
            document.getElementById("btnBackup");

        const textoBackup =
            document.getElementById("textoBackup");

        formBackup.addEventListener("submit", function () {

            btnBackup.disabled = true;

            textoBackup.innerHTML =
                "Gerando backup...";

        });

    </script>
}