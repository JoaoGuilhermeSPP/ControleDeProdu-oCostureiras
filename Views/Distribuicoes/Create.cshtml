@model CosturaProducao.ViewModels.DistribuicaoCreateVm

@{
    ViewData["Title"] = "Distribuir processo";
}

<section class="dashboard" data-testid="assignment-form-page">

    <div class="page-heading">

        <div>
            <p class="eyebrow">
                DISTRIBUIÇÃO · COSTUREIRA
            </p>

            <h1>Entregar processo</h1>
        </div>

        <a href="/Distribuicoes"
           data-testid="assignment-cancel-link">

            Voltar

        </a>

    </div>


    <form asp-controller="Distribuicoes"
          asp-action="Create"
          method="post"
          class="registration-form"
          data-testid="assignment-form">

        @Html.AntiForgeryToken()


        <!-- IDs da produção/processo -->

        <input type="hidden"
               asp-for="ProductionProcessId" />

        <input type="hidden"
               asp-for="ProductionId" />


        <!-- Informações do processo -->

        <p class="form-context"
           data-testid="assignment-production-context">

            @Model.ProductionDescription

            · R$
            @Model.PricePerPiece.ToString("N2")
            por peça

        </p>


        <!-- ERROS -->

        <div asp-validation-summary="ModelOnly"
             class="form-error"
             data-testid="assignment-form-error">
        </div>


        <!-- COSTUREIRA -->

        <label asp-for="SeamstressId">

            Costureira

            <select asp-for="SeamstressId"
                    data-testid="assignment-seamstress-select">

                <option value="">
                    Selecione uma costureira
                </option>

                @foreach (var item in Model.Seamstresses)
                {
                    <option value="@item.Id">
                        @item.Name
                    </option>
                }

            </select>

        </label>

        <span asp-validation-for="SeamstressId"
              class="form-error">
        </span>


        <!-- QUANTIDADE -->

        <label asp-for="PlannedQuantity">

            Quantidade planejada

            <input asp-for="PlannedQuantity"
                   type="number"
                   min="1"
                   data-testid="assignment-quantity-input" />

        </label>

        <span asp-validation-for="PlannedQuantity"
              class="form-error">
        </span>


        <!-- BOTÃO -->

        <button type="submit"
                class="btn btn-primary"
                data-testid="assignment-save-button">

            Distribuir processo

        </button>

    </form>

</section>