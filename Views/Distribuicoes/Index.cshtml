@model CosturaProducao.ViewModels.DistribuicaoIndexVm

@{
    ViewData["Title"] = "Distribuição";
}

<section class="dashboard" data-testid="assignment-list-page">

    <!-- CABEÇALHO -->
    <div class="page-heading">

        <div>
            <p class="eyebrow">
                PRODUÇÃO · ACOMPANHAMENTO
            </p>

            <h1>Distribuição</h1>
        </div>

    </div>


    <!-- FILTROS -->
    <div class="distribution-filters">

        <a href="/Distribuicoes?filtro=todos"
           class="@(Model.Filtro == "todos" ? "active" : "")">
            Todas
        </a>

        <a href="/Distribuicoes?filtro=andamento"
           class="@(Model.Filtro == "andamento" ? "active" : "")">
            Em andamento
        </a>

        <a href="/Distribuicoes?filtro=finalizadas"
           class="@(Model.Filtro == "finalizadas" ? "active" : "")">
            Finalizadas
        </a>

    </div>


    <!-- MENSAGEM DE ERRO -->
    @if (TempData["Error"] is not null)
    {
        <div class="form-error"
             data-testid="assignment-error-message">

            @TempData["Error"]

        </div>
    }


    <!-- MENSAGEM DE SUCESSO -->
    @if (TempData["Success"] is not null)
    {
        <div class="success-message"
             data-testid="assignment-success-message">

            @TempData["Success"]

        </div>
    }


    <!-- NENHUMA PRODUÇÃO -->
    @if (Model.Productions.Count == 0)
    {
        <div class="board-empty">

            @if (Model.Filtro == "finalizadas")
            {
                <p>Nenhuma produção finalizada.</p>
            }
            else if (Model.Filtro == "andamento")
            {
                <p>Nenhuma produção em andamento.</p>
            }
            else
            {
                <p>Nenhuma produção encontrada.</p>
            }

        </div>
    }


    <!-- PRODUÇÕES -->
    @foreach (var production in Model.Productions)
    {
        <article class="production-board"
                 data-testid="assignment-production-@production.Id">

            <!-- CABEÇALHO DA PRODUÇÃO -->
            <div class="board-heading">

                <div>

                    <strong>
                        @production.Client
                    </strong>

                    <span>
                        @production.Piece · @production.Quantity peças
                    </span>

                </div>

            </div>


            <!-- PROCESSOS -->
            @foreach (var process in production.Processes)
            {
                <div class="process-board"
                     data-testid="assignment-process-@process.Id">


                    <!-- CABEÇALHO DO PROCESSO -->
                    <div class="process-heading">

                        <div>

                            <strong>
                                @process.Name
                            </strong>

                            <span>
                                Planejado:
                                @process.Planned
                                · Produzido:
                                @process.Produced
                                ·
                                @process.Status
                            </span>

                        </div>


                        <!-- DISTRIBUIR -->
                        <a href="/Distribuicoes/Create?productionProcessId=@process.Id"
                           data-testid="assignment-add-@process.Id">

                            Distribuir

                        </a>

                    </div>


                    <!-- DISTRIBUIÇÕES -->
                    @foreach (var assignment in process.Assignments)
                    {
                        <form method="post"
                              action="/Distribuicoes/UpdateProgress"
                              class="assignment-line"
                              data-testid="assignment-row-@assignment.Id">

                            <input type="hidden"
                                   name="AssignmentId"
                                   value="@assignment.Id" />

                            @Html.AntiForgeryToken()


                            <!-- COSTUREIRA -->
                            <strong>
                                @assignment.Seamstress
                            </strong>


                            <!-- QUANTIDADE -->
                            <span>
                                @assignment.Planned peças
                                · R$ @assignment.Price.ToString("N2")
                            </span>


                            <!-- PRODUZIDO -->
                            <input name="ProducedQuantity"
                                   type="number"
                                   min="0"
                                   max="@assignment.Planned"
                                   value="@assignment.Produced"
                                   data-testid="assignment-produced-@assignment.Id" />


                            <!-- STATUS -->
                            <span class="status-label"
                                  data-testid="assignment-status-@assignment.Id">

                                @assignment.Status

                            </span>


                            <!-- ATUALIZAR -->
                            <button type="submit"
                                    class="link-button"
                                    data-testid="assignment-update-@assignment.Id">

                                Atualizar

                            </button>


                            <!-- PDF -->
                            <a href="/Pdf/Assignment/@assignment.Id"
                               data-testid="assignment-pdf-@assignment.Id" target="_blank">

                               Visualizar Relatório

                            </a>

                        </form>
                    }


                    <!-- SEM DISTRIBUIÇÃO -->
                    @if (process.Assignments.Count == 0)
                    {
                        <p class="board-empty"
                           data-testid="assignment-process-empty-@process.Id">

                            Ainda não distribuído.

                        </p>
                    }

                </div>
            }

        </article>
    }

</section>