@{
    ViewData["Title"] = "Entrar";
}
<section class="login-page" data-testid="owner-login-page">
    <div class="login-panel">
        <p class="eyebrow">CONTROLE DE PRODUÇÃO · 01</p>
        <h1>O trabalho bem feito começa com uma visão clara.</h1>
        <p class="lead">Organize clientes, peças, processos e entregas em um só lugar.</p>
        <a class="btn btn-primary btn-lg" href="/Identity/Account/Login" data-testid="owner-login-link">Entrar no painel</a>
    </div>
    <div class="login-manifesto" aria-label="Resumo do sistema" data-testid="production-manifesto">
        <span class="thread-line" aria-hidden="true"></span>
        <p class="eyebrow">MESA DE PRODUÇÃO</p>
        <div class="manifesto-list">
            <div data-testid="production-manifesto-item-1"><strong>01</strong><span>Cadastros organizados</span></div>
            <div data-testid="production-manifesto-item-2"><strong>02</strong><span>Distribuição rastreável</span></div>
            <div data-testid="production-manifesto-item-3"><strong>03</strong><span>Valores preservados</span></div>
        </div>
    </div>
</section>