@model CosturaProducao.ViewModels.RelatorioMensalVm
@{ ViewData["Title"] = "Relatório mensal"; }
<section class="dashboard" data-testid="monthly-report-page">
    <div class="page-heading"><div><p class="eyebrow">RELATÓRIOS · RESUMO MENSAL</p><h1>@Model.Month.ToString("00")/@Model.Year</h1></div><a href="/Relatorios" data-testid="seamstress-report-link">Por costureira</a></div>
    <form method="get" class="filter-bar" data-testid="monthly-filter-form"><label>Ano <input type="number" name="year" value="@Model.Year" min="2020" max="2100" data-testid="monthly-year-input" /></label><label>Mês <input type="number" name="month" value="@Model.Month" min="1" max="12" data-testid="monthly-month-input" /></label><button class="btn btn-primary" type="submit" data-testid="monthly-filter-button">Atualizar</button></form>
    <div class="metric-grid report-metrics"><article class="metric" data-testid="monthly-total-quantity"><span>Peças produzidas</span><strong>@Model.TotalProduced</strong><small>Produção realizada</small></article><article class="metric" data-testid="monthly-total-amount"><span>Total geral</span><strong>R$ @Model.TotalAmount.ToString("N2")</strong><small>Valor produzido</small></article></div>
    <div class="summary-actions"><a class="btn btn-primary" href="/Pdf/Monthly?year=@Model.Year&month=@Model.Month" data-testid="monthly-pdf-button">Baixar PDF mensal</a></div><div class="summary-columns"><article class="summary-card" data-testid="monthly-seamstress-summary"><h2>Por costureira</h2>@foreach (var row in Model.BySeamstress) { <div><strong>@row.Seamstress</strong><span>@row.Quantity peças · R$ @row.Amount.ToString("N2")</span></div>}</article><article class="summary-card" data-testid="monthly-client-summary"><h2>Por cliente</h2>@foreach (var row in Model.ByClient) { <div><strong>@row.Client</strong><span>@row.Quantity peças · R$ @row.Amount.ToString("N2")</span></div>}</article></div>
</section>