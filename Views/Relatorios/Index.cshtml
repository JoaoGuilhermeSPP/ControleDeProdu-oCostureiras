@model CosturaProducao.ViewModels.RelatorioFilterVm
@{ ViewData["Title"] = "Relatório por costureira"; }
<section class="dashboard" data-testid="report-page">
    <div class="page-heading"><div><p class="eyebrow">RELATÓRIOS · PRODUÇÃO REALIZADA</p><h1>Por costureira</h1></div><a href="/Relatorios/Monthly" data-testid="monthly-report-link">Relatório mensal</a></div>
    <form method="get" class="filter-bar" data-testid="report-filter-form"><label>Início <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" data-testid="report-start-date" /></label><label>Fim <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" data-testid="report-end-date" /></label><label>Costureira <select name="seamstressId" data-testid="report-seamstress-select"><option value="">Todas</option>@foreach (var item in Model.Seamstresses) { <option value="@item.Id" selected="@(Model.SeamstressId == item.Id ? "selected" : null)">@item.Name</option> }</select></label><button class="btn btn-primary" type="submit" data-testid="report-filter-button">Filtrar</button></form>
    <div class="metric-grid report-metrics"><article class="metric" data-testid="report-total-quantity"><span>Peças produzidas</span><strong>@Model.TotalProduced</strong><small>No período selecionado</small></article><article class="metric" data-testid="report-total-amount"><span>Valor produzido</span><strong>R$ @Model.TotalAmount.ToString("N2")</strong><small>Calculado por peça</small></article></div>
    <div class="registration-table report-table" data-testid="report-table"><div class="table-row table-head"><span>Costureira / cliente</span><span>Peça / serviço</span><span>Quantidade</span><span>Valor</span><span>Data</span></div>@foreach (var row in Model.Rows) { <div class="table-row"><strong>@row.Seamstress<br /><small>@row.Client</small></strong><span>@row.Piece<br /><small>@row.Service</small></span><span>@row.Quantity</span><span>R$ @row.Total.ToString("N2")<br /><small>R$ @row.Price.ToString("N2")/un</small></span><span>@row.Date.ToString("dd/MM/yyyy")</span></div>}</div>
</section>